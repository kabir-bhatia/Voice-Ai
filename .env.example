# LiveKit Cloud credentials (from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Vertex AI auth (service account key)
GOOGLE_APPLICATION_CREDENTIALS=/home/user/v3/service-account-key.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Self-hosted TTS (Kokoro-FastAPI, OpenAI-compatible endpoint)
TTS_BASE_URL=http://localhost:8002/v1
# Keep TTS_MODEL=tts-1 (NOT kokoro) — the LiveKit openai TTS plugin only sends raw audio
# for tts-1/tts-1-hd; other names use the SSE path Kokoro can't satisfy. Kokoro ignores it.
TTS_MODEL=tts-1
TTS_VOICE=af_alloy
