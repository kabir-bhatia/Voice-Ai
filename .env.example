# LiveKit Cloud credentials (from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# NOTE: fully self-hosted — NO Google credentials needed (no Vertex / no service account).

# Self-hosted LLM (Qwen2.5-7B via vLLM, OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen2.5-7b

# Self-hosted STT (faster-whisper-server, OpenAI-compatible endpoint)
# Upgraded to large-v3-turbo for accuracy. Alternatives: Systran/faster-distil-whisper-large-v3
# (fastest), Systran/faster-whisper-large-v3 (max accuracy). Must match WHISPER__MODEL in compose.
STT_BASE_URL=http://localhost:8001/v1
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2

# Self-hosted TTS (Kokoro-FastAPI, OpenAI-compatible endpoint)
TTS_BASE_URL=http://localhost:8002/v1
# Keep TTS_MODEL=tts-1 (NOT kokoro) — the LiveKit openai TTS plugin only sends raw audio
# for tts-1/tts-1-hd; other names use the SSE path Kokoro can't satisfy. Kokoro ignores it.
TTS_MODEL=tts-1
TTS_VOICE=af_alloy
